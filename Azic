local function CycleSkybox(forward)
    if forward then
        Config.CurrentSkyIndex = Config.CurrentSkyIndex + 1
        if Config.CurrentSkyIndex > #SkyboxNames then Config.CurrentSkyIndex = 1 end
    else
        Config.CurrentSkyIndex = Config.CurrentSkyIndex - 1
        if Config.CurrentSkyIndex < 1 then Config.CurrentSkyIndex = #SkyboxNames end
    end
    SetSkybox(SkyboxIds[SkyboxNames[Config.CurrentSkyIndex]])
end

