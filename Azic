-- 10. AIM ASSIST
-- ═══════════════════════════════════════════════════

local function AimAssist()
    if not Config.AimAssistEnabled then return end
    local target = GetClosestPlayer()
    if not target then return end
    
    local targetPos = target.Position
    if Config.PredictionEnabled then
        local root = target.Parent and target.Parent:FindFirstChild("HumanoidRootPart")
        if root then
            targetPos = targetPos + (root.Velocity * Config.PredictionAmount)
        end
    end
    
    local aimVector = (targetPos - Camera.CFrame.Position).Unit
    local newCFrame = Camera.CFrame:Lerp(
        CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + aimVector * 10),
        Config.AimAssistStrength
    )
    Camera.CFrame = newCFrame
end

