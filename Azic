-- 8. SILENT AIM
-- ═══════════════════════════════════════════════════

local function SetupSilentAim()
    if Config.SilentAimEnabled then
        if oldNamecall then return end
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if method == "FindPartOnRayWithIgnoreList" or method == "Raycast" then
                local target = GetClosestPlayer()
                if target and Config.Aimlock then
                    local origin = Camera.CFrame.Position
                    local direction = (target.Position - origin).Unit
                    
                    if Config.PredictionEnabled then
                        local root = target.Parent and target.Parent:FindFirstChild("HumanoidRootPart")
                        if root then
                            direction = (target.Position + (root.Velocity * Config.PredictionAmount) - origin).Unit
                        end
                    end
                    
                    local ray = Ray.new(origin, direction * 5000)
                    return ray, target.Position, target, direction
                end
            end
            return oldNamecall(self, ...)
        end)
    else
        if oldNamecall then
            restorefunction(oldNamecall)
            oldNamecall = nil
        end
    end
end

