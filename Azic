-- ═══════════════════════════════════════════════════
-- 17. ESP UPDATE (optimiert mit Caching)
-- ═══════════════════════════════════════════════════

local function UpdateESP()
    -- Alle ESP-Elemente zurücksetzen
    for _, box in pairs(ESPBoxes) do box.Visible = false end
    for _, name in pairs(ESPNames) do name.Visible = false end
    for _, health in pairs(ESPHealth) do health.Visible = false end
    for _, tracer in pairs(Tracers) do tracer.Visible = false end
    
    if not Config.ESPEnabled and not Config.TracersEnabled then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if not IsValidPlayer(player) then goto continue end
        if not IsEnemy(player) then goto continue end
        
        local root = player.Character:FindFirstChild("HumanoidRootPart")
        local humanoid = player.Character:FindFirstChild("Humanoid")
        if not root or not humanoid then goto continue end
        
        local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
        if not onScreen then goto continue end
        
        -- BOX ESP
        if Config.ESPEnabled and Config.BoxESPEnabled then
            local box = ESPBoxes[player]
            if not box then
                box = CreateESPBox(player)
                ESPBoxes[player] = box
            end
            local size = Vector2.new(2000 / pos.Z, 3000 / pos.Z)
            box.Size = size
            box.Position = Vector2.new(pos.X - size.X/2, pos.Y - size.Y/2)
            box.Visible = true
            box.Color = Config.ESPColor
        end
        
        -- NAME ESP
        if Config.ESPEnabled and Config.NameESPEnabled then
            local name = ESPNames[player]
            if not name then
                name = CreateESPName(player)
                ESPNames[player] = name
            end
            name.Position = Vector2.new(pos.X, pos.Y - 40)
            name.Visible = true
        end
        
        -- HEALTH ESP
        if Config.ESPEnabled and Config.HealthESPEnabled then
            local healthText = ESPHealth[player]
            if not healthText then
                healthText = CreateESPHealth(player)
                ESPHealth[player] = healthText
            end
            local hp = humanoid.Health
            local maxHp = humanoid.MaxHealth
            healthText.Text = math.floor(hp) .. "/" .. math.floor(maxHp)
            healthText.Position = Vector2.new(pos.X, pos.Y - 25)
            local healthPercent = hp / maxHp
            healthText.Color = Color3.new(1 - healthPercent, healthPercent, 0)
            healthText.Visible = true
        end
        
        -- TRACERS
        if Config.TracersEnabled then
            local tracer = Tracers[player]
            if not tracer then
                tracer = CreateTracer(player)
                Tracers[player] = tracer
            end
            tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            tracer.To = Vector2.new(pos.X, pos.Y)
            tracer.Visible = true
            tracer.Color = Config.ESPColor
        end
        
        -- CHAMS
        if Config.ChamsEnabled then
            local cham = Chams[player]
            if not cham then
                cham = CreateChams(player)
                Chams[player] = cham
            end
            cham.Enabled = true
            cham.FillColor = Config.ESPColor
        end
        
        ::continue::
    end
end

