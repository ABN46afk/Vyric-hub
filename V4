            if (method == "FindPartOnRayWithIgnoreList" or method == "Raycast") and Config.Aimlock then
                local target = GetClosestPlayer()
                if target then
                    local origin = Camera.CFrame.Position
                    local dir = (target.Position - origin).Unit
                    if Config.PredictionEnabled then
                        local hrp = target.Parent and target.Parent:FindFirstChild("HumanoidRootPart")
                        if hrp then dir = (target.Position + (hrp.Velocity * Config.PredictionAmount) - origin).Unit end
                    end
                    return Ray.new(origin, dir * 5000), target.Position, target, dir
                end
            end; return oldNamecall(self, ...)
        end)
    elseif oldNamecall then restorefunction(oldNamecall); oldNamecall = nil end
end

