local function ApplyPlayerSettings()
    local Character = Utility.GetCharacter(LocalPlayer)
    local Humanoid = Utility.GetHumanoid(Character)
    if not Humanoid then return end
    
    -- Walkspeed
    if Settings.Player.Walkspeed.Enabled then
        Humanoid.WalkSpeed = Settings.Player.Walkspeed.Value
    else
        Humanoid.WalkSpeed = 16
    end
    
    -- Jump Power
    if Settings.Player.JumpPower.Enabled then
        Humanoid.JumpPower = Settings.Player.JumpPower.Value
    else
        Humanoid.JumpPower = 50
    end
    
    -- Noclip
    if Settings.Player.Noclip then
        for _, part in pairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
    
    -- God Mode
    if Settings.Player.GodMode then
        Humanoid.MaxHealth = math.huge
        Humanoid.Health = math.huge
        Humanoid.BreakJointsOnDeath = false
    end
end

