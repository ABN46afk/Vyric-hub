        local keywords = {"anticheat","antiexploit","ac","security","guard","check","bancheck","detection","detect","ban","kick"}
        for _, obj in pairs(game:GetDescendants()) do
            if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                local n = obj.Name:lower()
                for _, kw in pairs(keywords) do if n:find(kw) then obj.Disabled = true; break end end
            end
            if obj:IsA("RemoteEvent") then
                local n = obj.Name:lower()
                for _, kw in pairs(keywords) do if n:find(kw) then obj:Destroy(); break end end
            end
        end
    end
end
