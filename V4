local function CleanupESP()
    for _, list in pairs(ESPObjects) do
        for _, obj in pairs(list) do
            if obj then
                if obj.Destroy then
                    obj:Destroy()
                elseif obj.Remove then
                    obj:Remove()
                end
            end
        end
    end
    ESPObjects.Boxes = {}
