local function CreateESPObject(Type, Player)
    if Type == "Box" then
        local box = Drawing.new("Square")
        box.Visible = false
        box.Color = Settings.ESP.BoxColor
        box.Thickness = Settings.ESP.BoxThickness
        box.Filled = false
        return box
    elseif Type == "Name" then
        local text = Drawing.new("Text")
        text.Visible = false
        text.Color = Settings.ESP.NameColor
        text.Size = 14
        text.Center = true
        text.Outline = true
        text.Text = Player.Name
        return text
    elseif Type == "Health" then
        local text = Drawing.new("Text")
        text.Visible = false
        text.Color = Settings.ESP.HealthColor
        text.Size = 12
        text.Center = true
        text.Outline = true
        return text
    elseif Type == "Tracer" then
        local line = Drawing.new("Line")
        line.Visible = false
        line.Color = Settings.ESP.TracerColor
        line.Thickness = Settings.ESP.TracerThickness
        return line
    elseif Type == "Chams" then
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESPChams"
        highlight.FillColor = Settings.ESP.ChamsColor
        highlight.FillTransparency = Settings.ESP.ChamsTransparency
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0
        highlight.Parent = Player.Character
        return highlight
    end
    return nil
end

local function UpdateESP()
    -- Alle ESP-Objekte zurücksetzen
    for _, list in pairs(ESPObjects) do
        for _, obj in pairs(list) do
            if obj and obj.Visible ~= nil then
                obj.Visible = false
            end
        end
    end
    
    if not Settings.ESP.Enabled then return end
    
    local MaxDistance = Settings.ESP.MaxDistance
    local PlayerPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player == LocalPlayer then continue end
        if not Utility.IsValid(Player) or not Utility.IsEnemy(Player) then continue end
        
        local Character = Utility.GetCharacter(Player)
        local Root = Utility.GetHumanoidRootPart(Character)
        if not Root then continue end
        
        -- Distance Check
        if PlayerPos and Utility.GetDistance(PlayerPos, Root) > MaxDistance then continue end
        
        local Humanoid = Utility.GetHumanoid(Character)
        local Pos, OnScreen = Camera:WorldToViewportPoint(Root.Position)
        
        if OnScreen then
            -- Box ESP
            if Settings.ESP.Box then
                local box = ESPObjects.Boxes[Player]
                if not box then
                    box = CreateESPObject("Box", Player)
                    ESPObjects.Boxes[Player] = box
                end
                local Size = Vector2.new(2000 / Pos.Z, 3000 / Pos.Z)
                box.Size = Size
                box.Position = Vector2.new(Pos.X - Size.X/2, Pos.Y - Size.Y/2)
                box.Visible = true
                box.Color = Settings.ESP.BoxColor
                box.Thickness = Settings.ESP.BoxThickness
            end
            
            -- Name ESP
            if Settings.ESP.Name then
                local name = ESPObjects.Names[Player]
                if not name then
                    name = CreateESPObject("Name", Player)
                    ESPObjects.Names[Player] = name
                end
                name.Position = Vector2.new(Pos.X, Pos.Y - 50)
                name.Visible = true
                   name.Visible = true
                name.Color = Settings.ESP.NameColor
            end
            
            -- Health ESP
            if Settings.ESP.Health and Humanoid then
                local health = ESPObjects.Health[Player]
                if not health then
                    health = CreateESPObject("Health", Player)
                    ESPObjects.Health[Player] = health
                end
                local HealthPercent = Humanoid.Health / Humanoid.MaxHealth
                health.Text = math.floor(Humanoid.Health) .. "/" .. math.floor(Humanoid.MaxHealth)
                health.Position = Vector2.new(Pos.X, Pos.Y - 35)
                health.Color = Color3.new(1 - HealthPercent, HealthPercent, 0)
                health.Visible = true
            end
            
            -- Tracers
            if Settings.ESP.Tracers then
                local tracer = ESPObjects.Tracers[Player]
                if not tracer then
                    tracer = CreateESPObject("Tracer", Player)
                    ESPObjects.Tracers[Player] = tracer
                end
                tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                tracer.To = Vector2.new(Pos.X, Pos.Y)
                tracer.Visible = true
                tracer.Color = Settings.ESP.TracerColor
                tracer.Thickness = Settings.ESP.TracerThickness
            end
            
            -- Chams
            if Settings.ESP.Chams then
                local cham = ESPObjects.Chams[Player]
                if not cham then
                    cham = CreateESPObject("Chams", Player)
                    ESPObjects.Chams[Player] = cham
                end
                cham.Enabled = true
                cham.FillColor = Settings.ESP.ChamsColor
                cham.FillTransparency = Settings.ESP.ChamsTransparency
            end
        end
    end
end

