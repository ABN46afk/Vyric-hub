-- MODUL 12: FARM-MANAGER (SMART)
-- =====================================================
local function SmartFarm()
    if not Settings.Farm.AutoFarm then return end
    
    local Character = Utility.GetCharacter(LocalPlayer)
    local Root = Utility.GetHumanoidRootPart(Character)
    if not Root then return end
    
    local Collected = 0
    local Priority = Settings.Farm.FarmPriority
    local CollectRadius = Settings.Farm.CollectRadius
    
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            local Name = v.Name:lower()
            for _, target in ipairs(Priority) do
                if Name:find(target:lower()) then
                    local Distance = Utility.GetDistance(Root, v)
                    if Distance <= CollectRadius then
                        Root.CFrame = v.CFrame * CFrame.new(0, 5, 0)
                        Collected = Collected + 1
                        task.wait(0.3)
                        break
                    end
                end
            end
        end
    end
    
    if Collected > 0 then
        Utility.Notify("🌾 Farm", Collected .. " Items gesammelt!", 2, "🌾")
    end
end

-- Farm Loop
RunService.RenderStepped:Connect(function()
    if Settings.Farm.AutoFarm then
        SmartFarm()
    end
end)

