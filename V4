local function PlaySound(SoundId)
    if not Settings.Sound.Enabled then return end
    pcall(function()
        local sound = Instance.new("Sound")
        sound.SoundId = SoundId or Settings.Sound.ClickSound
        sound.Volume = Settings.Sound.Volume
        sound.Parent = LocalPlayer:FindFirstChild("PlayerGui") or CoreGui
        sound:Play()
        task.wait(0.2)
        sound:Destroy()
    end)
end

