local Utility = {}

-- Character/Humanoid Checks
function Utility.GetCharacter(Player)
    return Player and Player.Character
end

function Utility.GetHumanoid(Character)
    return Character and Character:FindFirstChild("Humanoid")
end

function Utility.GetHumanoidRootPart(Character)
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

function Utility.GetTorso(Character)
    return Character and (Character:FindFirstChild("UpperTorso") or Character:FindFirstChild("Torso"))
end

-- Sicherheitschecks
function Utility.IsValid(Player)
    if not Player or Player == LocalPlayer then return false end
    local Character = Utility.GetCharacter(Player)
    if not Character then return false end
    local Humanoid = Utility.GetHumanoid(Character)
    if not Humanoid or Humanoid.Health <= 0 then return false end
    return true
end

function Utility.IsEnemy(Player)
    if not Utility.IsValid(Player) then return false end
    if not Settings.Aimlock.TeamCheck then return true end
    if LocalPlayer.Team and Player.Team then
        return LocalPlayer.Team ~= Player.Team
    end
    return true
end

-- Part suchen (Pfad oder Name)
function Utility.FindPart(input)
    if input == "" then return nil end
    local part = nil
    if input:find("%.") then
        local success, result = pcall(function()
            return loadstring("return " .. input)()
        end)
        if success and result and result:IsA("BasePart") then
            part = result
        end
    end
    if not part then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name == input then
                part = obj
                break
            end
        end
    end
    return part
end

-- Distance berechnen
function Utility.GetDistance(Part1, Part2)
    if not Part1 or not Part2 then return math.huge end
    return (Part1.Position - Part2.Position).Magnitude
end

-- Screen-Position prüfen
function Utility.IsOnScreen(WorldPosition)
    local Pos, OnScreen = Camera:WorldToViewportPoint(WorldPosition)
    return OnScreen, Pos
end

-- Notifications mit Sound
function Utility.Notify(Title, Content, Duration, Icon)
    if Settings.Sound.Enabled then
        local sound = Instance.new("Sound")
        sound.SoundId = Settings.Sound.ToggleSound
        sound.Volume = Settings.Sound.Volume
        sound.Parent = LocalPlayer:FindFirstChild("PlayerGui") or CoreGui
        sound:Play()
        task.wait(0.1)
        sound:Destroy()
    end
    WindUI:Notify({
        Title = Title,
        Content = Content,
        Duration = Duration or 3,
        Icon = Icon or "💬"
    })
end

