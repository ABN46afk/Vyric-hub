local SkySection = SkyTab:Section({Title = "Skybox Settings", Side = "Left"})
SkySection:Dropdown({Title = "Select Sky", Value = "Sunset", Options = SkyboxNames, Callback = function(v)
    CurrentSkyIndex = 0
    for i, name in pairs(SkyboxNames) do if name == v then CurrentSkyIndex = i; break end end
    if Config.SkysEnabled and defaultSky then
        local id = SkyboxIds[v]
        for _, face in pairs({"Bk","Dn","Ft","Lf","Rt","Up"}) do defaultSky["Skybox"..face] = id end
    end
end})
SkySection:Toggle({Title = "Skys Enabled", Value = false, Callback = function(v)
    Config.SkysEnabled = v
    if defaultSky then defaultSky.Enabled = v end
end})

