function UpdateESP()
    for _, v in pairs(ESPBoxes) do v.Visible = false end
    for _, v in pairs(ESPNames) do v.Visible = false end
    for _, v in pairs(ESPHealth) do v.Visible = false end
    for _, v in pairs(Tracers) do v.Visible = false end
    if not Config.ESPEnabled and not Config.TracersEnabled and not Config.DistanceESPEnabled then return end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0
            and IsEnemy(player) and IsWhitelisted(player) and IsFriend(player) then
            local root = player.Character.HumanoidRootPart; local hum = player.Character.Humanoid
            local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
            if onScreen then
                if Config.ESPEnabled and Config.BoxESPEnabled then
                    local box = ESPBoxes[player] or CreateBox(player); ESPBoxes[player] = box
                    local s = Vector2.new(2000/pos.Z, 3000/pos.Z); box.Size = s; box.Position = Vector2.new(pos.X-s.X/2, pos.Y-s.Y/2); box.Visible = true; box.Color = Config.ESPColor
                end
                if Config.ESPEnabled and Config.NameESPEnabled then
                    local n = ESPNames[player] or CreateName(player); ESPNames[player] = n; n.Position = Vector2.new(pos.X, pos.Y-40); n.Visible = true
                end
                if Config.ESPEnabled and Config.HealthESPEnabled then
                    local h = ESPHealth[player] or CreateHealth(); ESPHealth[player] = h
                    h.Text = math.floor(hum.Health).."/"..math.floor(hum.MaxHealth); h.Position = Vector2.new(pos.X, pos.Y-25)
                    local hp = hum.Health/hum.MaxHealth; h.Color = Color3.new(1-hp, hp, 0); h.Visible = true
                end
                if Config.DistanceESPEnabled then
                    local d = ESPHealth[player] or CreateHealth(); ESPHealth[player] = d
                    d.Text = math.floor((Camera.CFrame.Position - root.Position).Magnitude).."m"; d.Position = Vector2.new(pos.X, pos.Y+20); d.Visible = true
                end
                if Config.TracersEnabled then
                    local t = Tracers[player] or CreateTracer(); Tracers[player] = t
                    t.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y); t.To = Vector2.new(pos.X, pos.Y); t.Visible = true; t.Color = Config.ESPColor
                end
                if Config.ChamsEnabled then
                    local ch = Chams[player] or CreateChams(player); Chams[player] = ch; ch.Enabled = true; ch.FillColor = Config.ESPColor
                end
            else
                if ESPBoxes[player] then ESPBoxes[player].Visible = false end
                if ESPNames[player] then ESPNames[player].Visible = false end
                if ESPHealth[player] then ESPHealth[player].Visible = false end
                if Tracers[player] then Tracers[player].Visible = false end
                if Chams[player] then Chams[player].Enabled = false end
            end
        else
            if ESPBoxes[player] then ESPBoxes[player].Visible = false end
            if ESPNames[player] then ESPNames[player].Visible = false end
            if ESPHealth[player] then ESPHealth[player].Visible = false end
            if Tracers[player] then Tracers[player].Visible = false end
            if Chams[player] then Chams[player].Enabled = false end
        end
    end
end
function AutoParry()
    if not Config.AutoParryEnabled then return end
    local c = LocalPlayer.Character; local tool = c and c:FindFirstChildWhichIsA("Tool")
    if tool then
        local p = tool:FindFirstChild("Parry") or tool:FindFirstChild("Block") or tool:FindFirstChild("Counter")
        local re = tool:FindFirstChildWhichIsA("RemoteEvent")
        if p and re then re:FireServer(p, "Activate", true) end
    end
end

function AutoBlock()
    if not Config.AutoBlockEnabled then return end
    local c = LocalPlayer.Character
    if c then
        if c:FindFirstChild("Humanoid") then c.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, false) end
        local tool = c:FindFirstChildWhichIsA("Tool")
        if tool then
            local b = tool:FindFirstChild("Block") or tool:FindFirstChild("Guard") or tool:FindFirstChild("Defense")
            local re = tool:FindFirstChildWhichIsA("RemoteEvent")
            if b and re then re:FireServer(b, "Activate", true) end
        end
    end
end

function AutoHeal()
    if not Config.AutoHealEnabled then return end
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("Humanoid") and c.Humanoid.Health < Config.AutoHealThreshold then
        for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name:lower()
                if name:find("heal") or name:find("potion") or name:find("med") or name:find("bandage") or name:find("food") then
                    item.Parent = c; task.wait(0.1); item:Activate(); task.wait(0.1); item.Parent = LocalPlayer.Backpack; break
                end
            end
        end
    end
end

