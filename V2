MiscTab:Button({Title = "Refresh ESP", Callback = function() CleanupESP(); WindUI:Notify({Title = "ESP", Content = "ESP refreshed!", Duration = 2}) end})
MiscTab:Button({Title = "Copy Discord", Callback = function() setclipboard("https://discord.gg/azichub"); WindUI:Notify({Title = "Discord", Content = "Discord link copied!", Duration = 3}) end})
MiscTab:Button({Title = "Server Hop", Callback = function()
    CleanupESP(); Circle:Remove()
    if oldNamecall then restorefunction(oldNamecall) end
    Window:Destroy()
    task.wait(0.5)
    local HttpService = game:GetService("HttpService")
    local TeleportService = game:GetService("TeleportService")
    local PlaceId = game.PlaceId
    local servers = HttpService:JSONDecode(game:HttpGetAsync("https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?limit=100"))
    local newServerId = nil
    for _, server in pairs(servers.data) do
        if server.playing < server.maxPlayers and server.id ~= game.JobId then
            newServerId = server.id; break
        end
    end
    if newServerId then TeleportService:TeleportToPlaceInstance(PlaceId, newServerId, LocalPlayer) end
end})
MiscTab:Button({Title = "Rejoin Server", Callback = function()
    CleanupESP(); Circle:Remove()
    if oldNamecall then restorefunction(oldNamecall) end
    Window:Destroy()
    game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
end})
MiscTab:Button({Title = "Unload Script", Callback = function()
    CleanupESP(); Circle:Remove()
    if oldNamecall then restorefunction(oldNamecall) end
    Window:Destroy()
    WindUI:Notify({Title = "Unloaded", Content = "Script unloaded successfully!", Duration = 3})
end})

