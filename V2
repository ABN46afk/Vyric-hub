PlayerTab:Toggle({Title = "God Mode", Value = false, Callback = function(v) GodModeEnabled = v end})
SkyTab:Toggle({Title = "Enable Skys", Value = false, Callback = function(v)
    SkysEnabled = v
    if v then SetSkybox(SkyboxIds[SkyboxNames[CurrentSkyIndex]]) else local oldSky = Lighting:FindFirstChild("CustomSkybox"); if oldSky then oldSky:Destroy() end end
end})
SkyTab:Toggle({Title = "Enable Skys", Value = false, Callback = function(v)
    SkysEnabled = v
    if v then SetSkybox(SkyboxIds[SkyboxNames[CurrentSkyIndex]]) else local oldSky = Lighting:FindFirstChild("CustomSkybox"); if oldSky then oldSky:Destroy() end end
end})
SkyTab:Button({Title = "Next Sky", Callback = function() if SkysEnabled then CycleSkybox(true) end end})
SkyTab:Button({Title = "Previous Sky", Callback = function() if SkysEnabled then CycleSkybox(false) end end})
SkyTab:Dropdown({Title = "Select Sky", Values = SkyboxNames, Value = "Sunset", Callback = function(v)
    for i, name in ipairs(SkyboxNames) do if name == v then CurrentSkyIndex = i; break end end
    if SkysEnabled then SetSkybox(SkyboxIds[v]) end
end})

VisualTab:Colorpicker({Title = "FOV Color", Value = Color3.fromRGB(255, 255, 255), Callback = function(v) AimbotFOVColor = v end})
VisualTab:Toggle({Title = "No Fog", Value = false, Callback = function(v) if v then Lighting.FogEnd = 100000 else Lighting.FogEnd = 1000 end end})
VisualTab:Toggle({Title = "Full Bright", Value = false, Callback = function(v) if v then Lighting.Brightness = 2; Lighting.GlobalShadows = false else Lighting.Brightness = 1; Lighting.GlobalShadows = true end end})
VisualTab:Slider({Title = "Brightness", Value = {Min = 0, Max = 10, Default = 1, Decimals = 1}, Callback = function(v) Lighting.Brightness = v end})
VisualTab:Toggle({Title = "Remove Fog Color", Value = false, Callback = function(v) if v then Lighting.FogColor = Color3.new(0, 0, 0); Lighting.ColorShift_Top = Color3.new(1, 1, 1); Lighting.ColorShift_Bottom = Color3.new(1, 1, 1) else Lighting.FogColor = Color3.new(0.75, 0.75, 0.75) end end})
VisualTab:Toggle({Title = "Ambient Color", Value = false, Callback = function(v) if v then Lighting.Ambient = Color3.new(1, 1, 1) else Lighting.Ambient = Color3.new(0, 0, 0) end end})

FarmTab:Toggle({Title = "Auto Farm", Value = false, Callback = function(v) AutoFarmEnabled = v end})
