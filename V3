                    local healthText = ESPHealth[player]; if not healthText then healthText = CreateESPHealth(player); ESPHealth[player] = healthText end
                    healthText.Text = math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth); healthText.Position = Vector2.new(pos.X, pos.Y - 25)
                    local healthPercent = humanoid.Health / humanoid.MaxHealth; healthText.Color = Color3.new(1 - healthPercent, healthPercent, 0); healthText.Visible = true
                end
                if ESPEnabled and DistanceESPEnabled then
                    local distText = ESPDistance[player]; if not distText then distText = CreateESPDistance(player); ESPDistance[player] = distText end
                    local distance = math.floor((root.Position - Camera.CFrame.Position).Magnitude); distText.Text = distance .. " studs"; distText.Position = Vector2.new(pos.X, pos.Y - 55); distText.Visible = true
                end
                if TracersEnabled then
                    local tracer = Tracers[player]; if not tracer then tracer = CreateTracer(player); Tracers[player] = tracer end
                    tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y); tracer.To = Vector2.new(pos.X, pos.Y); tracer.Visible = true; tracer.Color = ESPColor
                end
                if ChamsEnabled then
                    local cham = Chams[player]; if not cham then cham = CreateChams(player); Chams[player] = cham end; cham.Enabled = true; cham.FillColor = ESPColor
                end
            else
                if ESPBoxes[player] then ESPBoxes[player].Visible = false end; if ESPNames[player] then ESPNames[player].Visible = false end
                if ESPHealth[player] then ESPHealth[player].Visible = false end; if ESPDistance[player] then ESPDistance[player].Visible = false end
                if Tracers[player] then Tracers[player].Visible = false end; if Chams[player] then Chams[player].Enabled = false end
            end
        else
            if ESPBoxes[player] then ESPBoxes[player].Visible = false end; if ESPNames[player] then ESPNames[player].Visible = false end
            if ESPHealth[player] then ESPHealth[player].Visible = false end; if ESPDistance[player] then ESPDistance[player].Visible = false end
            if Tracers[player] then Tracers[player].Visible = false end; if Chams[player] then Chams[player]:Destroy(); Chams[player] = nil end
        end
    end
end

local function SetSkybox(id)
    for _, v in pairs(Lighting:GetChildren()) do if v:IsA("Sky") then v:Destroy() end end
    local newSky = Instance.new("Sky"); newSky.Name = "CustomSkybox"
    newSky.SkyboxBk = id; newSky.SkyboxDn = id; newSky.SkyboxFt = id; newSky.SkyboxLf = id; newSky.SkyboxRt = id; newSky.SkyboxUp = id; newSky.Parent = Lighting
end

local function CycleSkybox(forward)
    if forward then CurrentSkyIndex = CurrentSkyIndex + 1; if CurrentSkyIndex > #SkyboxNames then CurrentSkyIndex = 1 end
    else CurrentSkyIndex = CurrentSkyIndex - 1; if CurrentSkyIndex < 1 then CurrentSkyIndex = #SkyboxNames end end
    SetSkybox(SkyboxIds[SkyboxNames[CurrentSkyIndex]])
end
