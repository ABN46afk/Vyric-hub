                        local humanoidRoot = target.Parent and target.Parent:FindFirstChild("HumanoidRootPart")
                        if humanoidRoot then direction = (target.Position + (humanoidRoot.Velocity * PredictionAmount) - origin).Unit end
                    end
                    local ray = Ray.new(origin, direction * 5000); return ray, target.Position, target, direction
                end
            end
            return oldNamecall(self, ...)
        end)
    elseif oldNamecall then restorefunction(oldNamecall); oldNamecall = nil end
end

