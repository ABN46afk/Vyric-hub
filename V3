        flyBodyGyro = Instance.new("BodyGyro"); flyBodyGyro.Parent = root; flyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9); flyBodyGyro.CFrame = root.CFrame
        flyBodyVelocity = Instance.new("BodyVelocity"); flyBodyVelocity.Parent = root; flyBodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9); flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
        RunService.RenderStepped:Connect(function()
            if not FlyEnabled or not isFlying then return end
